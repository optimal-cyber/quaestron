generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Entity {
  id                    String   @id @default(uuid())
  name                  String
  slug                  String   @unique
  type                  String   // DEFENSE_PRIME, CYBER_INTEL, SURVEILLANCE, AI_ML, INVESTOR, GOVERNMENT, CLOUD_INFRA, STARTUP, CONSULTANCY
  subTypes              String   @default("[]") // JSON array
  description           String   @default("")
  headquartersCountryId String?
  headquartersCity      String?
  founded               Int?
  website               String?
  alsoKnownAs           String   @default("[]") // JSON array
  fundingType           String?  // public, private, government
  ticker                String?
  stockExchange         String?
  cageCode              String?
  uei                   String?
  naicsCodes            String   @default("[]") // JSON array
  employeeCount         String?
  annualRevenue         String?
  isin                  String?
  logoUrl               String?
  // ─── Vendor-selection intelligence (cached; populated by syncVendor) ───
  businessSize          String?  // SMALL | OTHER (from SAM business types)
  setAsides             String   @default("[]") // JSON array: SMALL_BUSINESS, 8A, WOMAN_OWNED, SDVOSB, HUBZONE, ...
  riskFlags             String   @default("[]") // JSON array: FOREIGN_HQ, SURVEILLANCE_TIES, SAM_INACTIVE, EXPIRING_AUTH
  primaryAgency         String?  // top agency by obligated $
  agencyBreakdown       String?  // JSON cache: [{agency, awardCount, totalObligated}]
  totalFederalObligated Float?   // sum of federal contract obligations
  vendorSyncedAt        DateTime? // last on-demand vendor enrichment
  sources               String   @default("[]") // JSON array of {url, title, domain, date}
  providingTo           String   @default("[]") // JSON array of {name, alpha2, lat, lon}
  surveilling           String   @default("[]") // JSON array of {name, alpha2, lat, lon}
  hasDirectTargets      Boolean  @default(false)
  externalId            String?  @unique // ID from Surveillance Watch or other sources
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  headquartersCountry Country? @relation(fields: [headquartersCountryId], references: [id])
  connectionsFrom     Connection[] @relation("ConnectionSource")
  connectionsTo       Connection[] @relation("ConnectionTarget")
  contracts           Contract[]   @relation("ContractEntity")
  agencyContracts     Contract[]   @relation("ContractAgency")
  fundingRounds       FundingRound[]
  newsItems           NewsItemEntity[]
  fedrampAuths        FedrampAuthorization[] @relation("FedrampEntity")
  dodProvisionalAuths DodProvisionalAuth[]   @relation("DodPaEntity")
  emassAuths          EmassAuthorization[]   @relation("EmassEntity")
}

model Connection {
  id             String    @id @default(uuid())
  sourceEntityId String
  targetEntityId String
  connectionType String    // CONTRACTS, INVESTED_IN, ACQUIRED, SUBSIDIARY, PARTNERSHIP, SUPPLIES_TO, FUNDED_BY, LOBBIES, PERSONNEL_OVERLAP
  description    String?
  value          Float?
  startDate      DateTime?
  endDate        DateTime?
  sources        String    @default("[]")
  confidence     String    @default("confirmed") // confirmed, reported, inferred
  createdAt      DateTime  @default(now())

  sourceEntity Entity @relation("ConnectionSource", fields: [sourceEntityId], references: [id])
  targetEntity Entity @relation("ConnectionTarget", fields: [targetEntityId], references: [id])

  @@unique([sourceEntityId, targetEntityId, connectionType])
}

model Country {
  id        String  @id @default(uuid())
  name      String
  alpha2    String  @unique
  alpha3    String?
  latitude  Float
  longitude Float
  region    String?

  entities Entity[]
}

model Contract {
  id                 String    @id @default(uuid())
  awardId            String?   @unique
  entityId           String
  agencyId           String?
  description        String?
  value              Float?
  awardDate          DateTime?
  endDate            DateTime?
  naicsCode          String?
  psc                String?
  placeOfPerformance String?
  sources            String    @default("[]")
  // SBIR/STTR fields
  sbirProgram        String?   // "SBIR" or "STTR"
  sbirPhase          String?   // "I", "II", "III"
  sbirTopicCode      String?
  sbirAgency         String?   // Top-level agency: "DOD", "NASA", "HHS", etc.
  sbirBranch         String?   // Sub-agency: "Air Force", "Army", "DARPA", etc.
  sbirAwardYear      Int?
  sbirAbstract       String?
  sbirKeywords       String?   // JSON array
  sbirPiName         String?   // Principal Investigator
  createdAt          DateTime  @default(now())

  entity Entity  @relation("ContractEntity", fields: [entityId], references: [id])
  agency Entity? @relation("ContractAgency", fields: [agencyId], references: [id])
}

model FundingRound {
  id        String    @id @default(uuid())
  entityId  String
  roundType String?
  amount    Float?
  date      DateTime?
  investors String    @default("[]") // JSON array of entity IDs
  sources   String    @default("[]")
  source    String?   // government | apollo
  roundName String?   // e.g. "SBIR Phase II", "Series C", "Federal Awards FY24"
  provider  String?   // data provider (e.g. apollo.io)
  raw       String?   // JSON blob of the raw enrichment response
  createdAt DateTime  @default(now())

  entity Entity @relation(fields: [entityId], references: [id])

  @@index([entityId])
}

model NewsItem {
  id          String   @id @default(uuid())
  title       String
  url         String   @unique
  source      String
  publishedAt DateTime
  summary     String?
  createdAt   DateTime @default(now())

  relatedEntities NewsItemEntity[]
}

model NewsItemEntity {
  id         String @id @default(uuid())
  newsItemId String
  entityId   String

  newsItem NewsItem @relation(fields: [newsItemId], references: [id])
  entity   Entity   @relation(fields: [entityId], references: [id])

  @@unique([newsItemId, entityId])
}

model Submission {
  id              String   @id @default(uuid())
  submitterEmail  String?
  entityName      String
  entityType      String
  website         String?
  headquartersCountry String?
  description     String
  connectionInfo  String?  // free-text about connections/funding
  sourceUrls      String   @default("[]") // JSON array
  status          String   @default("pending") // pending, approved, rejected
  reviewNotes     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Auth / Accounts (Auth.js v5 + Prisma adapter) ─────────────────

model User {
  id              String    @id @default(uuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  // ─── Iron Echelon fields ───
  tier            String    @default("FREE") // FREE | PRO | TEAM
  role            String    @default("USER") // USER | ADMIN
  stripeCustomerId String?  @unique
  alertEmailOptIn Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  watchlists     Watchlist[]
  alertRules     AlertRule[]
  alertEvents    AlertEvent[]
  analystThreads AnalystThread[]
}

model Account {
  id                       String  @id @default(uuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Watchlists & Alerts ───────────────────────────────────────────

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]
  rules AlertRule[]

  @@index([userId])
}

model WatchlistItem {
  id          String   @id @default(uuid())
  watchlistId String
  targetType  String // ENTITY | FEDRAMP_CSO | AGENCY | KEYWORD | NAICS
  targetId    String? // Entity.id when targetType = ENTITY
  targetValue String? // packageId / agency name / keyword / NAICS code
  /// Normalized targetId ?? targetValue. Exists solely to give the uniqueness
  /// constraint a single non-null column to hang off.
  targetKey   String
  label       String? // display name captured at add time
  createdAt   DateTime @default(now())

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, targetType, targetKey])
  @@index([watchlistId])
  @@index([targetType, targetKey])
}

model AlertRule {
  id          String    @id @default(uuid())
  userId      String
  watchlistId String?
  ruleType    String // NEW_CONTRACT | FEDRAMP_STATUS_CHANGE | ATO_EXPIRING | NEW_SBIR_AWARD | RISK_FLAG_ADDED | NEWS_MENTION
  params      String    @default("{}") // JSON: rule-specific options (minValue, days, …)
  channel     String    @default("EMAIL") // EMAIL | IN_APP
  frequency   String    @default("WEEKLY") // REALTIME | DAILY | WEEKLY
  active      Boolean   @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchlist Watchlist?  @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  events    AlertEvent[]

  @@index([userId])
  @@index([active, frequency])
  @@index([watchlistId])
}

model AlertEvent {
  id        String    @id @default(uuid())
  ruleId    String
  userId    String
  ruleType  String
  title     String
  body      String    @default("")
  url       String?
  /// Idempotency key — the unique constraint is what makes re-running an
  /// evaluation over an overlapping lookback window a no-op.
  dedupeKey String    @unique
  entityId  String?
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([ruleId])
  @@index([emailedAt])
}

/// Last-seen values for change-detection rules. The cron overwrites source rows
/// in place, so "what changed" can only be answered against a stored baseline.
model AlertSnapshot {
  id        String   @id @default(uuid())
  kind      String // fedramp:status | entity:riskFlags
  key       String // packageId / entityId
  value     String
  updatedAt DateTime @updatedAt

  @@unique([kind, key])
  @@index([kind])
}

// ─── AI Analyst ────────────────────────────────────────────────────

model AnalystThread {
  id     String @id @default(uuid())
  userId String
  title  String @default("New thread")
  /// Set when the thread was opened from a vendor page, so the UI can show
  /// what it was seeded with and the model gets the context up front.
  entitySlug String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AnalystMessage[]

  @@index([userId, updatedAt])
}

model AnalystMessage {
  id       String @id @default(uuid())
  threadId String
  role     String // USER | ASSISTANT
  content  String @default("")
  /// JSON array of {name, input, resultSummary} — replayed into the transcript
  /// so a reloaded thread shows which datasets an answer came from.
  toolCalls String   @default("[]")
  /// Null on user turns and on assistant turns that completed normally.
  stopReason String?
  createdAt  DateTime @default(now())

  thread AnalystThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// ─── Rate limiting (LibSQL-backed fixed window) ────────────────────

model RateLimit {
  key       String   @id // "<bucket>:<identifier>:<windowIndex>"
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// ─── ATO Intelligence Models ───────────────────────────────────────

model FedrampAuthorization {
  id                 String    @id @default(uuid())
  packageId          String    @unique
  csoName            String
  cspName            String
  status             String    // Authorized, InProcess, Ready
  impactLevel        String?
  serviceModel       String    @default("[]") // JSON array
  deploymentModel    String?
  authorizationDate  DateTime?
  expirationDate     DateTime?
  sponsoringAgency   String?
  leveragingAgencies String    @default("[]") // JSON array
  assessorName       String?
  authType           String?   // Agency, JAB
  serviceDescription String?
  website            String?
  logo               String?
  /// UEI as published in the FedRAMP feed — a strong key for entity resolution,
  /// far more reliable than matching on company name.
  uei                String?
  /// Small-business flag as published by FedRAMP. Independent of
  /// Entity.businessSize, which comes from SAM and requires enrichment to run.
  smallBusiness      Boolean?
  /// Resolved from cspName by lib/match/ato-entity.ts. Nullable because not
  /// every CSP in the FedRAMP marketplace exists as a tracked Entity.
  entityId           String?
  lastSynced         DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  entity Entity? @relation("FedrampEntity", fields: [entityId], references: [id])

  @@index([status])
  @@index([impactLevel])
  @@index([cspName])
  @@index([sponsoringAgency])
  @@index([expirationDate])
  @@index([entityId])
  @@index([uei])
  @@index([smallBusiness])
}

model DodProvisionalAuth {
  id               String    @id @default(uuid())
  csoName          String
  cspName          String
  impactLevel      String    // IL2, IL4, IL5, IL6
  paDate           DateTime?
  paExpiration     DateTime?
  sponsorComponent String?
  conditions       String?
  source           String    @default("seed") // seed, manual, scraped
  /// Resolved from cspName by lib/match/ato-entity.ts.
  entityId         String?
  lastSynced       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  entity Entity? @relation("DodPaEntity", fields: [entityId], references: [id])

  @@unique([csoName, cspName, impactLevel])
  @@index([impactLevel])
  @@index([cspName])
  @@index([entityId])
}

model EmassAuthorization {
  id                  String    @id @default(uuid())
  systemName          String
  systemId            String?
  component           String    // Army, Navy, USAF, USMC, DISA, etc.
  authorizationType   String    // ATO, IATT, DATO, ATOwConditions
  authorizationDate   DateTime?
  expirationDate      DateTime?
  impactLevel         String?
  authorizingOfficial String?
  issm                String?
  isso                String?
  systemType          String?
  hostedLocation      String?
  cloudProvider       String?
  source              String    @default("manual")
  importBatchId       String?
  /// Resolved from cloudProvider (falling back to systemName) by
  /// lib/match/ato-entity.ts.
  entityId            String?
  lastSynced          DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  entity Entity? @relation("EmassEntity", fields: [entityId], references: [id])

  @@unique([systemName, component])
  @@index([component])
  @@index([impactLevel])
  @@index([expirationDate])
  @@index([authorizationType])
  @@index([entityId])
}

/// Names from the ATO feeds that the matcher could not confidently resolve to
/// an Entity. Surfaced in /admin so an operator can resolve them by hand;
/// aggregated by normalized name so a CSP with 40 offerings is one review item.
model AtoMatchReview {
  id               String   @id @default(uuid())
  sourceType       String // FEDRAMP | DOD_PA | EMASS
  sourceName       String // raw cspName / cloudProvider as it appears in the feed
  normalizedName   String
  recordCount      Int      @default(1)
  status           String   @default("PENDING") // PENDING | RESOLVED | IGNORED
  resolvedEntityId String?
  /// JSON array of near-misses: [{entityId, name, slug, score, method}]
  suggestions      String   @default("[]")
  lastSeenAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([sourceType, normalizedName])
  @@index([status])
  @@index([sourceType])
}

model AtoCompany {
  id              String   @id @default(uuid())
  canonicalName   String   @unique
  aliases         String   @default("[]") // JSON array
  cageCode        String?
  uei             String?
  website         String?
  sector          String?
  smallBusiness   Boolean  @default(false)
  sbTypes         String   @default("[]") // JSON array
  totalActiveAuths Int     @default(0)
  authVelocity    Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AtoSyncLog {
  id             String   @id @default(uuid())
  source         String   @unique
  lastSyncAt     DateTime @default(now())
  recordsAdded   Int      @default(0)
  recordsUpdated Int      @default(0)
  recordsFailed  Int      @default(0)
  status         String   @default("success") // success, failed, running
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FederalContract {
  id                String    @id @default(uuid())
  awardId           String    @unique
  recipientName     String
  recipientUei      String?
  awardingAgency    String?
  awardingSubAgency String?
  awardAmount       Float?
  description       String?
  startDate         DateTime?
  endDate           DateTime?
  naicsCode         String?
  psc               String?
  entityId          String?   // soft link to the matched Entity (no FK)
  atoRelevanceScore Int       @default(0)
  lastSynced        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([awardingAgency])
  @@index([atoRelevanceScore])
  @@index([recipientName])
  @@index([entityId])
}

model AtoAlert {
  id           String   @id @default(uuid())
  type         String   // expiring_30d, expiring_90d, new_authorization, status_change
  title        String
  details      String   @default("{}") // JSON blob
  source       String
  acknowledged Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([acknowledged])
  @@index([type])
}

// ─── Lobbying Disclosure Models ───────────────────────────────────

model LobbyingFiling {
  id                String    @id @default(uuid())
  filingId          String    @unique // Senate LD filing UUID
  registrantName    String
  clientName        String
  filingType        String?   // Registration, Report, Amendment
  filingYear        Int?
  filingPeriod      String?   // Q1, Q2, Q3, Q4, Mid-Year, Year-End
  amount            Float?    // Reported lobbying income/expenses
  issues            String    @default("[]") // JSON array of issue area codes
  lobbyists         String    @default("[]") // JSON array of {name, coveredPosition}
  governmentEntities String   @default("[]") // JSON array of agencies lobbied
  specificIssues    String?   // Free-text description of lobbying activity
  entityId          String?   // FK to our tracked Entity (if matched)
  source            String    @default("senate-lda")
  lastSynced        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([registrantName])
  @@index([clientName])
  @@index([filingYear])
  @@index([entityId])
}

// ─── SAM.gov Entity Registration ──────────────────────────────────

model SamRegistration {
  id                String    @id @default(uuid())
  uei               String    @unique // Unique Entity Identifier
  entityName        String
  cageCode          String?
  duns              String?
  physicalAddress   String?   // JSON: {line1, city, state, zip, country}
  mailingAddress    String?   // JSON
  congressionalDistrict String?
  naicsCodes        String    @default("[]") // JSON array
  pscCodes          String    @default("[]") // JSON array
  businessTypes     String    @default("[]") // JSON array (small business flags etc)
  entityStructure   String?   // Corporate, LLC, etc.
  stateOfIncorp     String?
  fiscalYearEnd     String?
  entityUrl         String?
  registrationDate  DateTime?
  expirationDate    DateTime?
  activeStatus      String?   // Active, Inactive
  entityId          String?   // FK to our tracked Entity (if matched)
  lastSynced        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([entityName])
  @@index([cageCode])
  @@index([entityId])
}
