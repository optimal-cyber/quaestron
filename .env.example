# ============================================
# IRON ECHELON — Environment Variables
# ============================================
# Copy to `.env` for local development. On Vercel, set these in
# Project Settings → Environment Variables.

# ------ DATABASE (Required) ------
# Local development: a SQLite file relative to the repo root.
DATABASE_URL="file:./dev.db"

# Production (Turso): hosted LibSQL database.
# Create at https://turso.tech, then `turso db show --url <name>`.
#
# WARNING: when TURSO_DATABASE_URL is set, local scripts and `prisma db push`
# target PRODUCTION — prisma.config.ts and lib/db.ts both prefer it over
# DATABASE_URL. Blank it out to work against dev.db:
#   TURSO_DATABASE_URL= TURSO_AUTH_TOKEN= npm run dev
TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# ------ AUTH (Phase 1) ------
# Required in production. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Canonical site URL. Set explicitly in production — it drives Auth.js callbacks,
# metadataBase, canonical/OG URLs, digest email links, and export footers.
# AUTH_URL="https://quaestron.io"

# Email magic-link sign-in via Resend (https://resend.com/api-keys).
# Omit to disable email sign-in — the provider is skipped, not broken.
RESEND_API_KEY=""
EMAIL_FROM="Iron Echelon <intel@ironechelon.com>"

# Google OAuth (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
# Omit both to disable Google sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------ PRIVILEGED ROUTES ------
# Bearer token for /api/admin/* and /api/sync/* machine callers.
# A signed-in user with role=ADMIN is also accepted (see `npm run admin:promote`).
# In production, leaving BOTH this and CRON_SECRET unset closes these routes
# entirely; in local dev an unset secret leaves them open for convenience.
SYNC_API_KEY=""
ADMIN_SECRET=""

# Bearer token for Vercel Cron (/api/cron/*, /api/sync/surveillance-watch).
# Vercel sends this automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=""

# ------ DATA SOURCES ------
# SAM.gov API key (https://sam.gov/content/api-keys) — vendor registration data.
SAM_SECRET=""

# ------ PLANNED (later phases) ------
# Stripe billing (Phase 5)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_TEAM=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# AI Analyst
# Without this the /analyst page renders but reports itself unconfigured.
ANTHROPIC_API_KEY=""
# Defaults to claude-sonnet-5. Pin to claude-sonnet-4-6, or raise to
# claude-opus-5 for the hardest analysis at higher cost.
ANTHROPIC_MODEL="claude-sonnet-5"
